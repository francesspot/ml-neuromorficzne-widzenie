   "outputs": [],
   "source": [
    "#changing the targets to numerical values:\n",
    "classes = sorted(set(dataset.targets))\n",
    "class_to_idx = {cls: i for i, cls in enumerate(classes)}\n",
    "dataset.targets = [class_to_idx[target] for target in dataset.targets]"
   ]
  },
