   "outputs": [],
   "source": [
    "transform_dataset = tonic.transforms.Compose([\n",
    "    tonic.transforms.Downsample(spatial_factor=0.5)\n",
    "])\n",
    "\n",
    "transform_train = tonic.transforms.Compose([\n",
    "    tonic.transforms.RandomCrop(sensor_size=(120,90,2), target_size=(80,80)),\n",
    "    tonic.transforms.RandomFlipLR(sensor_size=(80,80,2), p = 0.5),\n",
    "    tonic.transforms.EventDrop(sensor_size=(80,80,2)),\n",
    "    tonic.transforms.ToFrame(sensor_size=(80,80,2), n_time_bins=20)\n",
    "])\n",
    "\n",
    "transform_val = tonic.transforms.Compose([\n",
    "    tonic.transforms.CenterCrop(sensor_size=(120,90,2), size=(80,80)),\n",
    "    tonic.transforms.ToFrame(sensor_size=(80,80,2), n_time_bins=20)\n",
    "])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7ec2345f",
   "metadata": {},
   "outputs": [],
   "source": [
    "dataset = tonic.datasets.NCALTECH101(save_to = './Data_80_80' , transform=transform_dataset)"
   ]
  },
